[
{
  "family": "my-task-family",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": 512,
  "memory": 1024,
  "containerDefinitions": [
    {
      "name": "api",
      "image": "nginx:alpine",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-task-family",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "worker",
      "image": "nginx:alpine",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "environment": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-task-family",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
]