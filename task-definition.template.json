[
  {
    "family": "${TASK_DEFINITION_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": 256,
    "memory": 512,
    "containerDefinitions": [
      {
        "name": "test-world",
        "image": "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 3000,
            "protocol": "tcp"
          }
        ],
        "environment": [
          {
            "name": "ENVIRONMENT",
            "value": "${ENVIRONMENT}"
          },
          {
            "name": "AWS_REGION",
            "value": "${AWS_REGION}"
          },
          {
            "name": "SERVICE_NAME",
            "value": "${SERVICE_NAME}"
          },
          {
            "name": "APP_VERSION",
            "value": "${APP_VERSION}"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "${CLOUDWATCH_LOG_GROUP}",
            "awslogs-region": "${AWS_REGION}",
            "awslogs-stream-prefix": "${CLOUDWATCH_LOG_STREAM_PREFIX}"
          }
        }
      }
    ]
  }
]